rules_version = '2';
// Reglas de Firebase Storage — LPS 911. Solo el módulo Planos (docs/ia/planos.md) guarda archivos aquí:
// planos/<id>/r<rev>/… (miniatura, mosaicos de alta definición y el PDF original).
// Los permisos siguen a la colección "members" de Firestore, como firebase/firestore.rules:
// lee el equipo de Last Planner (no capataces ni roles de solo tareo); suben el administrador, los editores y Oficina Técnica; borra solo el administrador.
service firebase.storage {
  match /b/{bucket}/o {
    function verified() { return request.auth != null && request.auth.token.get('email_verified', false) == true; }
    function anon() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function mid() { return anon() ? 'u_' + request.auth.uid : request.auth.token.email.lower(); }
    function isOwner() { return verified() && request.auth.token.email.lower() == 'frandiopacheco@gmail.com'; }
    function memPath() { return /databases/(default)/documents/members/$(mid()); }
    function isMember() { return (verified() || anon()) && firestore.exists(memPath()); }
    function role() { return firestore.get(memPath()).data.get('role', ''); }
    // Oficina Técnica (área «OT» u «Oficina Técnica») también sube planos
    function isOT() { let d = firestore.get(memPath()).data; return d.get('role', '') == 'area' && d.get('area', '').lower().trim().matches('o\\.? ?t\\.?|oficina t[eé]cnica.*'); }
    // ETO de subcontratistas: etos/<sc>/… — el SC solo lee su carpeta; sube y borra solo el administrador
    function scsSt() { let d = firestore.get(memPath()).data; return d.get('scs', [d.get('sc', '')]); }
    match /etos/{sc}/{rest=**} {
      allow read: if isOwner() || (isMember() && !(role() in ['capataz', 'tcap', 'tasis', 'tcos']) && (role() != 'sc' || sc in scsSt()));
      allow create, update: if (isOwner() || (verified() && isMember() && role() == 'admin'))
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('image/webp|image/jpeg|image/png|application/pdf');
      allow delete: if isOwner() || (verified() && isMember() && role() == 'admin');
    }
    match /planos/{rest=**} {
      allow read: if isOwner() || (isMember() && !(role() in ['capataz', 'tcap', 'tasis', 'tcos']));
      // create y update (reintentar una subida a medias)
      allow create, update: if (isOwner() || (verified() && isMember() && (role() in ['admin', 'editor'] || isOT())))
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('image/webp|image/jpeg|image/png|application/pdf');
      // eliminar un plano con todos sus archivos: solo el administrador
      allow delete: if isOwner() || (verified() && isMember() && role() == 'admin');
    }
    // Modelo 3D (beta): modelos/<especialidad>/r<rev>.frag — mismos permisos que los planos
    match /modelos/{rest=**} {
      allow read: if isOwner() || (isMember() && !(role() in ['capataz', 'tcap', 'tasis', 'tcos']));
      allow create, update: if (isOwner() || (verified() && isMember() && (role() in ['admin', 'editor'] || isOT())))
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('application/octet-stream');
      // eliminar un modelo (todas sus revisiones): solo el administrador
      allow delete: if isOwner() || (verified() && isMember() && role() == 'admin');
    }
  }
}
