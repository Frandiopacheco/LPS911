rules_version = '2';
// Reglas de seguridad — Last Planner 911
// Solo los correos registrados en la colección "members" (pestaña Equipo)
// y con el correo confirmado pueden leer. Administrador y Editor editan todo;
// el rol Campo solo registra el avance diario (colecciones daily y fotos).
// Si cambias el correo del administrador principal, cámbialo también en firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.get('email_verified', false) == true; }
    // Capataces: ingresan con un enlace / QR (sesión anónima) y quedan registrados como members/u_<uid>
    function anon() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function signedIn() { return verified() || anon(); }
    function email() { return request.auth.token.email.lower(); }
    function mid() { return anon() ? 'u_' + request.auth.uid : email(); }
    function isOwner() { return verified() && email() == 'frandiopacheco@gmail.com'; }
    function memberPath() { return /databases/$(database)/documents/members/$(mid()); }
    function isMember() { return signedIn() && (isOwner() || exists(memberPath())); }
    function role() { return isOwner() ? 'admin' : get(memberPath()).data.role; }
    // Roles de solo Tareo (docs/ia/tareo.md): no leen ni escriben nada de LPS. Se lee con get('role') para no fallar
    // si un registro no tiene rol (antes isMember() bastaba para leer).
    function tarOnly() { return !isOwner() && get(memberPath()).data.get('role', '') in ['tcap', 'tasis', 'tcos']; }
    // Miembro de LPS: todo el equipo menos los roles de solo Tareo (lectura de las colecciones de LPS)
    function lpsMember() { return isMember() && !tarOnly(); }
    // Tareo: ven el módulo los roles de tareo, el administrador y el editor marcado «Publica tareo» (members.tpub)
    function isTar() {
      return isMember() && (role() in ['tcap', 'tasis', 'tcos', 'admin']
        || (role() == 'editor' && get(memberPath()).data.get('tpub', false) == true));
    }
    // Tareo: editan el máster de personal y las partidas de control el administrador y el asistente de tareo
    function tarEd() { return isMember() && role() in ['admin', 'tasis']; }
    function canEdit() { return isMember() && role() in ['admin', 'editor']; }
    function isAdmin() { return isMember() && role() == 'admin'; }
    // Versión para el cliente: el administrador y quienes él designe (members.cli), nunca subcontratistas ni capataces.
    function canCli() { return isAdmin() || (isMember() && role() in ['editor', 'campo', 'area', 'lector'] && get(memberPath()).data.get('cli', false) == true); }
    // Plan maestro: solo el administrador y el planner (rol que solo modifica el maestro). Nadie más lo lee.
    function canMP() { return isMember() && role() in ['admin', 'planner']; }
    function canDaily() { return isMember() && role() in ['admin', 'editor', 'campo']; }
    function scOf() { return get(memberPath()).data.get('sc', ''); }
    // Una persona puede tener varias empresas/partidas (campo 'scs'); si no existe, se usa 'sc'.
    function scsOf() { let d = get(memberPath()).data; return d.get('scs', [d.get('sc', '')]); }
    function isSC() { return isMember() && !isOwner() && role() == 'sc'; }
    function isCap() { return isMember() && !isOwner() && role() == 'capataz'; }
    // capataz o subcontratista (reportes en vivo de su partida)
    function crew() { return isMember() && !isOwner() && role() in ['capataz', 'sc']; }
    // Área de apoyo (Oficina Técnica, Calidad…): ve todo y gestiona las restricciones de su área
    function isArea() { return isMember() && !isOwner() && role() == 'area'; }
    function areaOf() { return get(memberPath()).data.get('area', ''); }
    // Calidad: un área de apoyo cuyo nombre contiene "calidad"
    function isCal() { return isArea() && areaOf().lower().matches('.*calidad.*'); }
    // Veedor: recorre la obra y registra lo que se ejecuta sin estar programado (no cambia nada más)
    function isVeedor() { return isMember() && !isOwner() && role() == 'veedor'; }
    // Trabajo no programado visto en obra: campo, editores, administrador, Calidad y veedores
    function canNP() { return canDaily() || isVeedor() || isCal(); }
    function areaRestrOk(d) { return areaOf() != '' && d.get('area', '') == areaOf() && d.get('grp', 'area') == 'area'; }
    function invDoc(c) { return get(/databases/$(database)/documents/inv/$(c)).data; }
    function invOk(c) { let i = get(/databases/$(database)/documents/inv/$(c)).data; return i.active == true && i.exp > request.time.toMillis(); }
    function scPdzOld(d) { return d.get('sc', '') in scsOf() && !(d.get('kind', '') in ['xok', 'aviso', 'pub'])
      && !(d.get('kind', '') == 'nova' && (d.get('k', '') != '' || d.get('ids', null) != null || d.get('draft', false) == true || d.get('eng', false) == true)); }
    function scPdzNew(d) { return d.get('kind', '') != 'dprop' || d.get('st', 'pend') == 'pend'; }
    // actividad de una partida del SC
    function actMine(aid) { let ap = /databases/$(database)/documents/acts/$(aid == '' ? '-' : aid); return exists(ap) && get(ap).data.get('sc', '') in scsOf(); }
    // forma de lo que escribe el SC: propuesta con id dp_<fecha>_<actividad> de su partida; equipo fz_<fecha>_<sc> / fzl_<sc>;
    // «no se hará hoy» (nova sin reprogramar) solo de hoy o días pasados y de una actividad de su partida
    function scPdzShape(id, d) {
      let k = d.get('kind', '');
      return (k != 'dprop' || (id == 'dp_' + d.get('date', '') + '_' + d.get('actId', '') && actMine(d.get('actId', ''))))
        && (k != 'fza' || id == 'fz_' + d.get('date', '') + '_' + d.get('sc', ''))
        && (k != 'fzl' || id == 'fzl_' + d.get('sc', ''))
        && (k != 'nova' || (!dplanFuture(d.get('date', '')) && actMine(d.get('actId', '')) && !d.keys().hasAny(['mv', 'pub', 'rid'])));
    }
    // una propuesta ya aceptada (ok) no la cambia ni la borra el SC; una rechazada solo vuelve a pendiente
    function scDpropFrom(d) { return d.get('kind', '') != 'dprop' || d.get('st', 'pend') in ['pend', 'rej']; }
    // Responsable de piso: un editor escribe el plan diario (pdz) y su foto (dplan) solo en los pisos a su cargo
    // (pisos/{id}.resp = lista de correos); piso sin responsable: cualquier editor. El administrador siempre.
    function respOk(pid) {
      let pp = /databases/$(database)/documents/pisos/$(pid == '' ? '-' : pid);
      return !exists(pp) || noResp(get(pp).data) || email() in get(pp).data.resp;
    }
    function noResp(d) { let r = d.get('resp', []); return r == null || r.size() == 0; }
    function edPiso(d) { return isAdmin() || (canEdit() && respOk(d.get('pisoId', ''))); }
    function dataCol(c) { return c in ['meta', 'pisos', 'contractors', 'sectors', 'ambientes', 'acts', 'weeks', 'restr', 'planos', 'lhidx', 'lhver', 'laminas', 'lamimg']; }

    match /members/{mail} {
      // la lista completa (con correos) solo la ve el personal interno; cada uno siempre puede leer su propio registro
      // el asistente de tareo también lee la lista (para asignar obreros a capataces); no la cambia
      allow read: if canDaily() || (signedIn() && mail == mid()) || (isMember() && role() == 'tasis');
      allow write: if isAdmin() && (mail == mail.lower() || mail.matches('u_.*'));
      // el capataz se registra solo con un enlace vigente, y solo para la partida del enlace
      // (una invitación del tareo, role:'tcap', no sirve para entrar como capataz de un SC ni al revés)
      allow create: if anon() && mail == 'u_' + request.auth.uid
        && request.resource.data.role == 'capataz'
        && request.resource.data.keys().hasOnly(['role', 'name', 'scs', 'sc', 'inv', 'added'])
        && invOk(request.resource.data.inv)
        && invDoc(request.resource.data.inv).get('role', 'capataz') == 'capataz'
        && request.resource.data.scs == invDoc(request.resource.data.inv).scs;
      // capataz del tareo (consorcio): con una invitación role:'tcap', sin partida
      allow create: if anon() && mail == 'u_' + request.auth.uid
        && request.resource.data.role == 'tcap'
        && request.resource.data.keys().hasOnly(['role', 'name', 'inv', 'added'])
        && invOk(request.resource.data.inv)
        && invDoc(request.resource.data.inv).get('role', 'capataz') == 'tcap';
      // el capataz puede cambiar solo su nombre
      allow update: if anon() && mail == 'u_' + request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
    }
    // Enlaces de invitación de capataces: los crea el administrador; cualquiera con sesión puede leer uno por su código
    match /inv/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }
    // Estado en vivo de cada actividad (iniciada / detenida / cierre propuesto)
    // El subcontratista también inicia, detiene y reanuda las de su partida y, como el capataz, propone el cierre del día
    // (campo 'close'); lo confirma el ingeniero en Campo (o el servidor a los 2 días). El SC no escribe el registro diario.
    // Capataz y SC: el documento debe ser de una actividad real de su partida (id = fecha_actividad, la partida y el piso
    // los de la actividad), no basta con la partida que declara el propio documento.
    function liveActOk(id) {
      let d = request.resource.data;
      let ap = /databases/$(database)/documents/acts/$(d.get('actId', '-'));
      return id == d.get('date', '') + '_' + d.get('actId', '') && exists(ap)
        && get(ap).data.get('sc', '') == d.get('sc', '') && livePisoOk(get(ap).data.get('ambId', '-'), d.get('pisoId', ''));
    }
    // piso de la actividad: ambiente → sector → piso (si el sector no dice su piso, no se puede comprobar)
    function livePisoOk(ambId, pid) {
      let am = /databases/$(database)/documents/ambientes/$(ambId);
      let sp = /databases/$(database)/documents/sectors/$(exists(am) ? get(am).data.get('sectorId', '-') : '-');
      return !exists(sp) || get(sp).data.get('pisoId', '') == '' || get(sp).data.pisoId == pid;
    }
    match /live/{id} {
      allow read: if lpsMember();
      allow create: if canDaily() || (crew() && request.resource.data.sc in scsOf() && liveActOk(id))
        || (isVeedor() && liveActOk(id) && request.resource.data.keys().hasOnly(['date', 'actId', 'pisoId', 'sc', 'seq', 'log', 'sat']));
      // el veedor solo marca o quita «en secuencia» (tren de trabajo): no inicia, no detiene ni cierra
      allow update: if canDaily() || (crew() && resource.data.sc in scsOf() && request.resource.data.sc in scsOf() && liveActOk(id))
        || (isVeedor() && liveActOk(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq', 'log', 'sat']));
      allow delete: if canDaily();
    }
    // Propuestas del lookahead: el subcontratista edita la de su partida; el editor (ingeniero de producción) las resuelve
    function lhpHistOk() {
      return (resource == null && !('hist' in request.resource.data))
        || (resource != null && request.resource.data.get('hist', {}) == resource.data.get('hist', {}));
    }
    match /lhprop/{sc} {
      allow read: if lpsMember();
      // el SC cambia sus borradores y envíos, pero no las «Respuestas del ingeniero» (hist): esas solo las escribe quien decide
      allow write: if canEdit() || (isSC() && sc in scsOf() && request.resource.data.get('sc', sc) == sc && lhpHistOk());
    }
    // Plan del día cerrado (foto de lo comprometido; contra ella se mide el PPC diario). La escribe quien publica (editor/admin)
    // y el servidor a las 20:00. Reabrir (reo) es solo del administrador; un editor solo puede dejarlo cerrado (reo vacío).
    // fecha YYYY-MM-DD posterior a hoy (hora de Lima, UTC-5)
    function dplanFuture(d) {
      return d.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) > request.time - duration.value(5, 'h');
    }
    match /dplan/{id} {
      allow read: if lpsMember();
      // Cerrado (con ids y sin reabrir), el editor no cambia lo comprometido ni el registro: solo el administrador (reabrir con motivo).
      // El editor publica de nuevo un día reabierto o que aún no tenía foto. «Deshacer publicación»: el editor solo en días futuros.
      // además, el editor solo en los pisos a su cargo (respOk)
      allow create: if isAdmin() || (edPiso(request.resource.data) && request.resource.data.get('reo', null) == null);
      allow update: if isAdmin() || (edPiso(resource.data) && edPiso(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reo']) || request.resource.data.get('reo', null) == null)
        && (resource.data.get('reo', null) != null || resource.data.get('ids', null) == null
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ids', 'log', 'date', 'pisoId'])));
      allow delete: if isAdmin() || (edPiso(resource.data) && dplanFuture(resource.data.get('date', '')));
    }
    // Historial de cambios del lookahead (uno por cambio): lo escribe quien edita; no se cambia ni se borra
    match /lhlog/{id} {
      allow read: if lpsMember();
      allow create: if canEdit() && request.resource.data.get('by', '') == mid();
      allow update, delete: if false;
    }
    // Constancia del congelado automático de cada semana (la escribe solo el servidor)
    match /frz/{id} {
      allow read: if lpsMember();
      allow write: if false;
    }
    // Historial de decisiones sobre propuestas (un documento por decisión). Lo escribe solo quien decide; después solo
    // se marca o desmarca «deshecho» (undone). No se borra: es la constancia de qué se autorizó, cuándo y por qué.
    match /lhphist/{id} {
      allow read: if lpsMember();
      allow create: if canEdit();
      allow update: if canEdit() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['undone']);
    }
    // Restricciones: editor/admin todo (regla general de abajo). El subcontratista crea las de actividades de su partida
    // y edita o borra solo las que él registró, mientras estén pendientes (liberarlas es del ingeniero).
    function scRestrOk(d) {
      return d.get('sc', '') in scsOf() && d.get('by', '') == mid()
        && d.get('status', 'pend') != 'lib' && d.get('freed', '') == ''
        && d.get('actId', '') != ''
        && get(/databases/$(database)/documents/acts/$(d.actId)).data.get('sc', '') == d.sc;
    }
    match /restr/{id} {
      allow create: if (isSC() && scRestrOk(request.resource.data))
        || (isArea() && areaRestrOk(request.resource.data));
      allow update: if (isSC() && scRestrOk(resource.data) && scRestrOk(request.resource.data))
        || (isArea() && areaRestrOk(resource.data) && areaRestrOk(request.resource.data));
      allow delete: if isSC() && scRestrOk(resource.data);
    }
    // Liberaciones de calidad: las solicita el SC (de su partida), el ingeniero de producción o Calidad;
    // las programa y decide Calidad (o el editor / administrador). El SC solo pide, levanta observaciones o anula las suyas.
    match /lib/{id} {
      allow read: if lpsMember();
      // crítica, supervisión y «restringe a» las marca Calidad al programar (ya no hay matriz): el SC no las pone ni las cambia
      allow create: if canEdit() || isCal()
        || (isSC() && request.resource.data.sc in scsOf() && request.resource.data.st == 'sol' && request.resource.data.by == mid()
            && request.resource.data.get('crit', false) == false && request.resource.data.get('sup', false) == false
            && request.resource.data.get('rest', '') == '');
      allow update: if canEdit() || isCal()
        || (isSC() && resource.data.sc in scsOf() && request.resource.data.sc == resource.data.sc
            && resource.data.st in ['sol', 'obs', 'lev'] && request.resource.data.st in ['sol', 'obs', 'lev', 'anu']
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['crit', 'sup', 'rest']));
      allow delete: if isAdmin();
    }
    // Versión para el cliente (holguras, versiones emitidas): el administrador y quienes él designe.
    // Los demás trabajan con la versión interna y no la ven.
    match /cli/{id} {
      allow read, write: if canCli();
    }
    match /clidx/{id} {
      allow read, create, update: if canCli();
      allow delete: if isAdmin();
    }
    match /cliver/{id} {
      allow read, create, update: if canCli();
      allow delete: if isAdmin();
    }
    // Matriz de liberaciones: la ven todos; la editan Calidad y el administrador
    match /libm/{id} {
      allow read: if lpsMember();
      allow write: if isAdmin() || isCal();
    }
    // Plan maestro (docs/plan-maestro.md): nodos (mp), avance por corte (mpav), vínculos con el lookahead (mpl) y configuración (mpcfg)
    match /mp/{id} {
      allow read, write: if canMP();
    }
    match /mpav/{id} {
      allow read, write: if canMP();
    }
    match /mpl/{id} {
      allow read, write: if canMP();
    }
    match /mpcfg/{id} {
      allow read, write: if canMP();
    }
    // Versiones de la línea base: el planner las envía a aprobación (pend); solo el administrador aprueba o devuelve. No se borran.
    match /mpver/{id} {
      allow read: if canMP();
      allow create: if isAdmin() || (canMP() && request.resource.data.get('st', '') == 'pend');
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /daily/{id} {
      allow read: if lpsMember();
      allow write: if canDaily();
    }
    // Trabajo no programado registrado en el recorrido (con punto en el plano y foto).
    // Cada uno corrige o anula lo suyo; campo, editores y administrador, todo. Nadie lo borra de verdad (se anula con del).
    match /nprog/{id} {
      allow read: if lpsMember();
      allow create: if canNP() && request.resource.data.by == mid();
      allow update: if canDaily() || (canNP() && resource.data.by == mid() && request.resource.data.by == mid());
      allow delete: if isAdmin();
    }
    // el rol se calcula una sola vez (con una función por rol se pasa el límite de 1000 expresiones de las reglas)
    function fotoNewOk() {
      let d = request.resource.data;
      let r = isMember() ? role() : '';
      return d.data.size() < 400000
        && (r == 'admin' || (r in ['editor', 'campo', 'capataz', 'sc', 'area', 'veedor'] && d.get('by', '') == mid()));
    }
    match /fotos/{id} {
      allow read: if lpsMember();
      // una foto queda a nombre de quien la sube (by); ya guardada, nadie la reemplaza (evidencia): solo el administrador
      allow create: if fotoNewOk();
      allow update: if isAdmin() && request.resource.data.data.size() < 400000;
      allow delete: if canDaily();
    }
    // Plano diario: zonas y notas del día. Editor/Admin todo; Subcontratista solo lo de su empresa.
    // Plan del día: el SC dibuja, propone (dprop pendiente) y reparte sus cuadrillas; las decisiones del ingeniero
    // (cruces, avisos, publicación y reprogramaciones «no va» con k/ids/borrador) no las puede crear, cambiar ni borrar.
    // El editor, solo en los pisos a su cargo (edPiso). El SC: propuestas con id fijo y de sus actividades, sin escribir la decisión
    // (dec*): al volver a proponer sobre una rechazada reemplaza el documento entero y la decisión anterior se quita.
    match /pdz/{id} {
      allow read: if lpsMember();
      allow create: if edPiso(request.resource.data)
        || (isSC() && scPdzOld(request.resource.data) && scPdzNew(request.resource.data) && scPdzShape(id, request.resource.data)
            && !request.resource.data.keys().hasAny(['dec', 'decBy', 'decN', 'decT']));
      allow update: if (edPiso(resource.data) && edPiso(request.resource.data))
        || (isSC() && scPdzOld(resource.data) && scDpropFrom(resource.data) && scPdzOld(request.resource.data) && scPdzNew(request.resource.data)
            && scPdzShape(id, request.resource.data) && !request.resource.data.keys().hasAny(['dec', 'decBy', 'decN', 'decT']));
      allow delete: if edPiso(resource.data) || (isSC() && scPdzOld(resource.data) && scDpropFrom(resource.data));
    }
    // Última zona usada por cada actividad (para "Como antes")
    match /pzon/{id} {
      allow read: if lpsMember();
      allow create: if canEdit() || (isSC() && request.resource.data.get('sc', '') in scsOf());
      allow update: if canEdit() || (isSC() && request.resource.data.get('sc', '') in scsOf()
        && (!('sc' in resource.data) || resource.data.sc in scsOf()));
      allow delete: if canEdit();
    }
    // Reloj: cada sesión escribe y lee su propio documento para conocer la hora del servidor
    match /clock/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Índice de actividades terminadas (para no tener que leer todo el historial diario)
    match /doneidx/{p} {
      allow read: if lpsMember();
      allow write: if canDaily();
    }
    // Pisos: el editor los edita, pero los responsables (resp, lista de correos) los pone solo el administrador (Equipo)
    match /pisos/{id} {
      allow read: if lpsMember();
      allow create: if isAdmin() || (canEdit() && noResp(request.resource.data));
      allow update: if isAdmin() || (canEdit() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['resp']));
      allow delete: if isAdmin() || (canEdit() && noResp(resource.data));
    }
    // ── Módulo Tareo (docs/ia/tareo.md) ── no se borra nada: «Eliminar» archiva (arch) o desactiva (act:false).
    // Máster de personal: id = DNI (8 a 12 letras o dígitos, con ceros a la izquierda)
    function tperOk(id) {
      let d = request.resource.data;
      return d.get('dni', null) is string && d.dni == id && d.dni.matches('[A-Za-z0-9]{8,12}');
    }
    match /tper/{id} {
      allow read: if isTar();
      allow create, update: if tarEd() && tperOk(id);
    }
    // Partidas de control
    function tpcOk() {
      let d = request.resource.data;
      return d.get('cod', null) is string && d.get('nom', null) is string;
    }
    match /tpc/{id} {
      allow read: if isTar();
      allow create, update: if tarEd() && tpcOk();
    }
    // Configuración del tareo (jornada, refrigerio, límites): la cambia solo el administrador
    match /tcfg/{id} {
      allow read: if isTar();
      allow write: if isAdmin();
    }
    // Tareo del día: tareo/{fecha}_{capId}. El capataz del tareo (tcap) solo ve y llena los suyos; tcos no ve nada (hasta F3).
    function tarRole() { return role() in ['tcap', 'tcos'] ? role() : 'ofi'; }
    // fecha YYYY-MM-DD entre hace 3 días y hoy (hora de Lima, UTC-5; tolera un día por el reloj y la zona)
    function tDateOk(d) {
      return d is string && d.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) <= request.time - duration.value(5, 'h') + duration.value(1, 'd')
        && timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) >= request.time - duration.value(5, 'h') - duration.value(4, 'd');
    }
    // el id termina en _<mi id> (para abrir su día aunque aún no exista)
    function idMine(id) { return id.size() > 11 && id[11:id.size()] == mid() && id[10:11] == '_'; }
    function tcapNew(id) {
      let d = request.resource.data;
      return d.get('cap', '') == mid() && d.get('date', null) is string && id == d.date + '_' + mid() && tDateOk(d.date);
    }
    // historial del tareo: el capataz solo agrega al final (una entrada por escritura: su «Enviado»); no cambia ni quita las de la oficina
    function tHistOk() {
      let o = resource.data.get('hist', []);
      let n = request.resource.data.get('hist', []);
      return n is list && n.size() >= o.size() && n.size() <= o.size() + 1 && n[0:o.size()] == o;
    }
    match /tareo/{id} {
      allow get: if isTar() && (tarRole() == 'ofi'
        || (tarRole() == 'tcap' && (resource == null ? idMine(id) : resource.data.get('cap', '') == mid())));
      allow list: if isTar() && (tarRole() == 'ofi' || (tarRole() == 'tcap' && resource.data.get('cap', '') == mid()));
      allow create: if tarEd() || (isTar() && tarRole() == 'tcap' && tcapNew(id)
        && request.resource.data.get('st', 'bor') in ['bor', 'env']
        && !request.resource.data.keys().hasAny(['reab', 'pub', 'revAt', 'revBy']));
      allow update: if tarEd() || (isTar() && tarRole() == 'tcap' && tcapNew(id)
        && resource.data.get('cap', '') == mid() && resource.data.get('date', '') == request.resource.data.date
        && resource.data.get('st', 'bor') in ['bor', 'reab']
        && request.resource.data.get('st', 'bor') in [resource.data.get('st', 'bor'), 'env']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reab', 'pub', 'revAt', 'revBy'])
        && tHistOk());
    }
    // Fotos del formato físico firmado: tfot/{fecha}_{capId}_… ; nadie las cambia ni las borra
    match /tfot/{id} {
      allow read: if isTar() && (tarRole() == 'ofi' || (tarRole() == 'tcap' && resource.data.get('cap', '') == mid()));
      allow create: if request.resource.data.get('d', null) is string && request.resource.data.d.size() < 1000000
        && (tarEd() || (isTar() && tarRole() == 'tcap' && request.resource.data.get('cap', '') == mid()
          && request.resource.data.get('date', null) is string && tDateOk(request.resource.data.date)
          && id.size() > (request.resource.data.date + '_' + mid()).size()
          && id[0:(request.resource.data.date + '_' + mid()).size()] == request.resource.data.date + '_' + mid()));
    }
    match /{col}/{id} {
      allow read: if lpsMember() && dataCol(col);
      allow write: if canEdit() && dataCol(col) && col != 'pisos';
    }
  }
}
