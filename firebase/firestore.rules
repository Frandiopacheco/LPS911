rules_version = '2';
// Reglas de seguridad — Last Planner 911
// Solo los correos registrados en la colección "members" (pestaña Equipo)
// y con el correo confirmado pueden leer. Administrador y Editor editan todo;
// el rol Campo solo registra el avance diario (colecciones daily y fotos).
// Si cambias el correo del administrador principal, cámbialo también en firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.get('email_verified', false) == true; }
    // Capataces: ingresan con un enlace / QR (sesión anónima) y quedan registrados como members/u_<uid>
    function anon() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function signedIn() { return verified() || anon(); }
    function email() { return request.auth.token.email.lower(); }
    function mid() { return anon() ? 'u_' + request.auth.uid : email(); }
    function isOwner() { return verified() && email() == 'frandiopacheco@gmail.com'; }
    function memberPath() { return /databases/$(database)/documents/members/$(mid()); }
    function isMember() { return signedIn() && (isOwner() || exists(memberPath())); }
    function role() { return isOwner() ? 'admin' : get(memberPath()).data.role; }
    function canEdit() { return isMember() && role() in ['admin', 'editor']; }
    function isAdmin() { return isMember() && role() == 'admin'; }
    // Versión para el cliente: el administrador y quienes él designe (members.cli), nunca subcontratistas ni capataces.
    function canCli() { return isAdmin() || (isMember() && role() in ['editor', 'campo', 'area', 'lector'] && get(memberPath()).data.get('cli', false) == true); }
    function canDaily() { return isMember() && role() in ['admin', 'editor', 'campo']; }
    function scOf() { return get(memberPath()).data.get('sc', ''); }
    // Una persona puede tener varias empresas/partidas (campo 'scs'); si no existe, se usa 'sc'.
    function scsOf() { let d = get(memberPath()).data; return d.get('scs', [d.get('sc', '')]); }
    function isSC() { return isMember() && !isOwner() && role() == 'sc'; }
    function isCap() { return isMember() && !isOwner() && role() == 'capataz'; }
    // Área de apoyo (Oficina Técnica, Calidad…): ve todo y gestiona las restricciones de su área
    function isArea() { return isMember() && !isOwner() && role() == 'area'; }
    function areaOf() { return get(memberPath()).data.get('area', ''); }
    // Calidad: un área de apoyo cuyo nombre contiene "calidad"
    function isCal() { return isArea() && areaOf().lower().matches('.*calidad.*'); }
    // Veedor: recorre la obra y registra lo que se ejecuta sin estar programado (no cambia nada más)
    function isVeedor() { return isMember() && !isOwner() && role() == 'veedor'; }
    // Trabajo no programado visto en obra: campo, editores, administrador, Calidad y veedores
    function canNP() { return canDaily() || isVeedor() || isCal(); }
    function areaRestrOk(d) { return areaOf() != '' && d.get('area', '') == areaOf() && d.get('grp', 'area') == 'area'; }
    function invOk(c) { let i = get(/databases/$(database)/documents/inv/$(c)).data; return i.active == true && i.exp > request.time.toMillis(); }
    function scPdzOld(d) { return d.get('sc', '') in scsOf() && !(d.get('kind', '') in ['xok', 'aviso', 'pub'])
      && !(d.get('kind', '') == 'nova' && (d.get('k', '') != '' || d.get('ids', null) != null || d.get('draft', false) == true || d.get('eng', false) == true)); }
    function scPdzNew(d) { return d.get('kind', '') != 'dprop' || d.get('st', 'pend') == 'pend'; }
    function dataCol(c) { return c in ['meta', 'pisos', 'contractors', 'sectors', 'ambientes', 'acts', 'weeks', 'restr', 'planos', 'lhidx', 'lhver', 'laminas', 'lamimg']; }

    match /members/{mail} {
      // la lista completa (con correos) solo la ve el personal interno; cada uno siempre puede leer su propio registro
      allow read: if canDaily() || (signedIn() && mail == mid());
      allow write: if isAdmin() && (mail == mail.lower() || mail.matches('u_.*'));
      // el capataz se registra solo con un enlace vigente, y solo para la partida del enlace
      allow create: if anon() && mail == 'u_' + request.auth.uid
        && request.resource.data.role == 'capataz'
        && request.resource.data.keys().hasOnly(['role', 'name', 'scs', 'sc', 'inv', 'added'])
        && invOk(request.resource.data.inv)
        && request.resource.data.scs == get(/databases/$(database)/documents/inv/$(request.resource.data.inv)).data.scs;
      // el capataz puede cambiar solo su nombre
      allow update: if anon() && mail == 'u_' + request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
    }
    // Enlaces de invitación de capataces: los crea el administrador; cualquiera con sesión puede leer uno por su código
    match /inv/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }
    // Estado en vivo de cada actividad (iniciada / detenida / cierre propuesto)
    // El subcontratista también inicia, detiene y reanuda las de su partida, pero no cierra el día (campo 'close').
    match /live/{id} {
      allow read: if isMember();
      allow create: if canDaily() || (isCap() && request.resource.data.sc in scsOf())
        || (isSC() && request.resource.data.sc in scsOf() && !('close' in request.resource.data));
      allow update: if canDaily() || (isCap() && resource.data.sc in scsOf() && request.resource.data.sc in scsOf())
        || (isSC() && resource.data.sc in scsOf() && request.resource.data.sc in scsOf()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['close']));
      allow delete: if canDaily();
    }
    // Propuestas del lookahead: el subcontratista edita la de su partida; el editor (ingeniero de producción) las resuelve
    function lhpHistOk() {
      return (resource == null && !('hist' in request.resource.data))
        || (resource != null && request.resource.data.get('hist', {}) == resource.data.get('hist', {}));
    }
    match /lhprop/{sc} {
      allow read: if isMember();
      // el SC cambia sus borradores y envíos, pero no las «Respuestas del ingeniero» (hist): esas solo las escribe quien decide
      allow write: if canEdit() || (isSC() && sc in scsOf() && request.resource.data.get('sc', sc) == sc && lhpHistOk());
    }
    // Historial de decisiones sobre propuestas (un documento por decisión). Lo escribe solo quien decide; después solo
    // se marca o desmarca «deshecho» (undone). No se borra: es la constancia de qué se autorizó, cuándo y por qué.
    match /lhphist/{id} {
      allow read: if isMember();
      allow create: if canEdit();
      allow update: if canEdit() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['undone']);
    }
    // Restricciones: editor/admin todo (regla general de abajo). El subcontratista crea las de actividades de su partida
    // y edita o borra solo las que él registró, mientras estén pendientes (liberarlas es del ingeniero).
    function scRestrOk(d) {
      return d.get('sc', '') in scsOf() && d.get('by', '') == mid()
        && d.get('status', 'pend') != 'lib' && d.get('freed', '') == ''
        && d.get('actId', '') != ''
        && get(/databases/$(database)/documents/acts/$(d.actId)).data.get('sc', '') == d.sc;
    }
    match /restr/{id} {
      allow create: if (isSC() && scRestrOk(request.resource.data))
        || (isArea() && areaRestrOk(request.resource.data));
      allow update: if (isSC() && scRestrOk(resource.data) && scRestrOk(request.resource.data))
        || (isArea() && areaRestrOk(resource.data) && areaRestrOk(request.resource.data));
      allow delete: if isSC() && scRestrOk(resource.data);
    }
    // Liberaciones de calidad: las solicita el SC (de su partida), el ingeniero de producción o Calidad;
    // las programa y decide Calidad (o el editor / administrador). El SC solo pide, levanta observaciones o anula las suyas.
    match /lib/{id} {
      allow read: if isMember();
      allow create: if canEdit() || isCal()
        || (isSC() && request.resource.data.sc in scsOf() && request.resource.data.st == 'sol' && request.resource.data.by == mid());
      allow update: if canEdit() || isCal()
        || (isSC() && resource.data.sc in scsOf() && request.resource.data.sc == resource.data.sc
            && resource.data.st in ['sol', 'obs', 'lev'] && request.resource.data.st in ['sol', 'obs', 'lev', 'anu']);
      allow delete: if isAdmin();
    }
    // Versión para el cliente (holguras, versiones emitidas): el administrador y quienes él designe.
    // Los demás trabajan con la versión interna y no la ven.
    match /cli/{id} {
      allow read, write: if canCli();
    }
    match /clidx/{id} {
      allow read, create, update: if canCli();
      allow delete: if isAdmin();
    }
    match /cliver/{id} {
      allow read, create, update: if canCli();
      allow delete: if isAdmin();
    }
    // Matriz de liberaciones: la ven todos; la editan Calidad y el administrador
    match /libm/{id} {
      allow read: if isMember();
      allow write: if isAdmin() || isCal();
    }
    match /daily/{id} {
      allow read: if isMember();
      allow write: if canDaily();
    }
    // Trabajo no programado registrado en el recorrido (con punto en el plano y foto).
    // Cada uno corrige o anula lo suyo; campo, editores y administrador, todo. Nadie lo borra de verdad (se anula con del).
    match /nprog/{id} {
      allow read: if isMember();
      allow create: if canNP() && request.resource.data.by == mid();
      allow update: if canDaily() || (canNP() && resource.data.by == mid() && request.resource.data.by == mid());
      allow delete: if isAdmin();
    }
    match /fotos/{id} {
      allow read: if isMember();
      allow create, update: if (canDaily() || isCap() || isSC() || isArea() || isVeedor()) && request.resource.data.data.size() < 400000;
      allow delete: if canDaily();
    }
    // Plano diario: zonas y notas del día. Editor/Admin todo; Subcontratista solo lo de su empresa.
    // Plan del día: el SC dibuja, propone (dprop pendiente) y reparte sus cuadrillas; las decisiones del ingeniero
    // (cruces, avisos, publicación y reprogramaciones «no va» con k/ids/borrador) no las puede crear, cambiar ni borrar.
    match /pdz/{id} {
      allow read: if isMember();
      allow create: if canEdit() || (isSC() && scPdzOld(request.resource.data) && scPdzNew(request.resource.data));
      allow update: if canEdit() || (isSC() && scPdzOld(resource.data) && scPdzOld(request.resource.data) && scPdzNew(request.resource.data));
      allow delete: if canEdit() || (isSC() && scPdzOld(resource.data));
    }
    // Última zona usada por cada actividad (para "Como antes")
    match /pzon/{id} {
      allow read: if isMember();
      allow create: if canEdit() || (isSC() && request.resource.data.get('sc', '') in scsOf());
      allow update: if canEdit() || (isSC() && request.resource.data.get('sc', '') in scsOf()
        && (!('sc' in resource.data) || resource.data.sc in scsOf()));
      allow delete: if canEdit();
    }
    // Reloj: cada sesión escribe y lee su propio documento para conocer la hora del servidor
    match /clock/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Índice de actividades terminadas (para no tener que leer todo el historial diario)
    match /doneidx/{p} {
      allow read: if isMember();
      allow write: if canDaily();
    }
    match /{col}/{id} {
      allow read: if isMember() && dataCol(col);
      allow write: if canEdit() && dataCol(col);
    }
  }
}
